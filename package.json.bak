{
    "name":  "echoscript-frontend",
    "version":  "1.0.0",
    "private":  true,
    "description":  "EchoScript.AI frontend application - advanced transcription UI with React, TailwindCSS, and Framer Motion",
    "type":  "module",
    "author":  "EchoScript Team",
    "license":  "ISC",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview --port 3000",
                    "preview:ci":  "vite preview --port 4173 --host",
                    "lint":  "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
                    "format":  "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md,json}\""
                },
    "browserslist":  [
                         "\u003e0.5%",
                         "last 2 versions",
                         "not dead",
                         "not op_mini all"
                     ],
    "devDependencies":  {
                            "@rollup/plugin-commonjs":  "^28.0.3",
                            "@rollup/plugin-node-resolve":  "^16.0.1",
                            "@sentry/react":  "^9.23.0",
                            "@sentry/tracing":  "^7.120.3",
                            "@tailwindcss/aspect-ratio":  "^0.4.2",
                            "@tailwindcss/forms":  "^0.5.10",
                            "@tailwindcss/line-clamp":  "^0.4.4",
                            "@tailwindcss/postcss":  "^4.1.13",
                            "@tailwindcss/typography":  "^0.5.16",
                            "@vitejs/plugin-react":  "^4.5.0",
                            "autoprefixer":  "^10.4.21",
                            "eslint":  "^9.27.0",
                            "plausible-tracker":  "^0.3.9",
                            "postcss":  "^8.5.6",
                            "posthog-js":  "^1.248.1",
                            "prettier":  "^3.5.3",
                            "react-transition-group":  "^4.4.5",
                            "rollup":  "^4.41.1",
                            "tailwindcss":  "^3.4.13",
                            "typescript":  "^5.8.3",
                            "vite":  "^6.3.5",
                            "vite-plugin-environment":  "^1.1.3",
                            "vite-plugin-pwa":  "^1.0.0",
                            "vite-plugin-svgr":  "^4.5.0"
                        },
    "dependencies":  {
                         "@auth0/auth0-react":  "^2.5.0",
                         "@headlessui/react":  "^2.2.8",
                         "@heroicons/react":  "^2.2.0",
                         "@paypal/react-paypal-js":  "^8.9.1",
                         "@react-spring/web":  "^10.0.1",
                         "@react-three/drei":  "^9.86.4",
                         "@react-three/fiber":  "^8.13.6",
                         "@stripe/react-stripe-js":  "^3.7.0",
                         "@stripe/stripe-js":  "^7.3.1",
                         "axios":  "^1.9.0",
                         "classnames":  "^2.5.1",
                         "dotenv":  "^16.5.0",
                         "framer-motion":  "^12.23.22",
                         "gsap":  "^3.13.0",
                         "https-proxy-agent":  "^7.0.6",
                         "i18next":  "^25.5.2",
                         "i18next-browser-languagedetector":  "^8.1.0",
                         "lottie-react":  "^2.4.1",
                         "lucide-react":  "^0.544.0",
                         "nprogress":  "^0.2.0",
                         "prop-types":  "^15.8.1",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-grid-layout":  "^1.5.1",
                         "react-helmet-async":  "^2.0.5",
                         "react-i18next":  "^15.7.3",
                         "react-icons":  "^5.5.0",
                         "react-markdown":  "^10.1.0",
                         "react-router-dom":  "^7.9.1",
                         "react-select":  "^5.10.1",
                         "react-swipeable":  "^7.0.2",
                         "react-tsparticles":  "^2.12.2",
                         "react-type-animation":  "^3.2.0",
                         "recharts":  "^3.0.0",
                         "tailwind-merge":  "^3.3.1",
                         "three":  "^0.160.0",
                         "tsparticles-slim":  "^2.12.0"
                     }
}
