{
  "name": "echoscript-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "EchoScript.AI frontend application - advanced transcription UI with React, TailwindCSS, and Framer Motion",
  "type": "module",
  "author": "EchoScript Team",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "preview:ci": "vite preview --port 4173 --host",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "prepare": "husky"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^4.6.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.2",
    "vite-plugin-environment": "^1.1.3"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.8.0",
    "@eslint/js": "^9.39.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.23.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.18.2",
    "globals": "^16.5.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^3.0.3",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.395.0",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.1",
    "react-swipeable": "^7.0.2",
    "react-tsparticles": "^2.12.2",
    "react-type-animation": "^3.2.0",
    "tailwind-merge": "^2.6.0",
    "tsparticles-slim": "^2.12.0"
  }
}
